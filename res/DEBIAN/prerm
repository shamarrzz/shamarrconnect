#!/bin/bash

set -e

case $1 in
    remove)
		INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
		rm -f /usr/bin/shamarrconnect

		if [ "systemd" == "${INITSYS}" ]; then

			systemctl stop shamarrconnect || true
			systemctl disable shamarrconnect || true
			rm -f /etc/systemd/system/shamarrconnect.service /usr/lib/systemd/system/shamarrconnect.service || true

			# workaround temp dev build between 1.1.9 and 1.2.0
			serverUser=$(ps -ef | grep -E 'shamarrconnect +--server' | grep -v 'sudo ' | awk '{print $1}' | head -1)
			if [ "$serverUser" != "" ] && [ "$serverUser" != "root" ]
			then
				systemctl --machine=${serverUser}@.host --user stop shamarrconnect >/dev/null 2>&1 || true
			fi
			rm -f /usr/lib/systemd/user/shamarrconnect.service >/dev/null 2>&1 || true
		fi
        ;;
    upgrade)
        ;;
esac

exit 0
